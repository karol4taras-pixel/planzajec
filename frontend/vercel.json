{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/plan.py": { "memory": 1024, "maxDuration": 30 },
    "api/sync-schedule.py": { "memory": 1024, "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/sync-schedule",
      "schedule": "0 6 * * *"
    }
  ]
}
